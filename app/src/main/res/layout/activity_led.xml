<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/activity_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05070A">

    <LinearLayout
        android:id="@+id/visualizer_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="18dp"
        android:paddingTop="16dp"
        android:paddingRight="18dp"
        android:paddingBottom="92dp">

        <TextView
            android:id="@+id/text_visualizer_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/led_visualizer_title"
            android:textColor="#F7FAFF"
            android:textSize="20sp" />

        <com.usbsdk.sample.LedStripPreviewView
            android:id="@+id/led_preview"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/text_waveform_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/led_waveform_label"
            android:textColor="#9FEFFF"
            android:textSize="13sp" />

        <com.usbsdk.sample.SharedLineVisualizer
            android:id="@+id/line_visualizer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/text_frequency_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/led_frequency_label"
            android:textColor="#FFD280"
            android:textSize="13sp" />

        <com.usbsdk.sample.SharedBarVisualizer
            android:id="@+id/bar_visualizer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/effect_buttons_scroll"
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:layout_gravity="bottom"
        android:background="#AA111820"
        android:fillViewport="false"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/effect_buttons_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button_music"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginRight="8dp"
                android:text="@string/led_button_music" />

            <Button
                android:id="@+id/button_static_white"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginRight="8dp"
                android:text="@string/led_button_static_white" />

            <Button
                android:id="@+id/button_breath"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginRight="8dp"
                android:text="@string/led_button_breath" />

            <Button
                android:id="@+id/button_flicker"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginRight="8dp"
                android:text="@string/led_button_flicker" />

            <Button
                android:id="@+id/button_gradient"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginRight="8dp"
                android:text="@string/led_button_gradient" />

            <Button
                android:id="@+id/button_lamp"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginRight="8dp"
                android:text="@string/led_button_chase" />

            <Button
                android:id="@+id/button_rainbow"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginRight="8dp"
                android:text="@string/led_button_rainbow" />

            <Button
                android:id="@+id/button_random"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginRight="8dp"
                android:text="@string/led_button_random" />

            <Button
                android:id="@+id/button_red"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginRight="8dp"
                android:text="@string/led_button_red" />

            <Button
                android:id="@+id/button_green"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginRight="8dp"
                android:text="@string/led_button_green" />

            <Button
                android:id="@+id/button_blue"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginRight="8dp"
                android:text="@string/led_button_blue" />
        </LinearLayout>
    </HorizontalScrollView>
</FrameLayout>
